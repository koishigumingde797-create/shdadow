root = true

# 全体共通設定
[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C# ファイル向け個別設定
[*.cs]
# ------------------------------------------------------------------------------
# メンバー修飾子スタイル（this. の明示を強制）
# ------------------------------------------------------------------------------
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning

# ------------------------------------------------------------------------------
# 言語仕様・構文スタイル（C# 10以降）
# ------------------------------------------------------------------------------
# ファイルスコープ名前空間を推奨（インデント削減）
csharp_style_namespace_declarations = file_scoped:warning

# パターンマッチング・式表現
csharp_style_pattern_matching_over_is_syntax = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion

# 型推論
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent

# usingディレクティブ・整理
csharp_prefer_simple_using_statement = true:suggestion
dotnet_sort_system_directives_first = true:suggestion
dotnet_separate_import_directive_groups = false:silent

# ------------------------------------------------------------------------------
# Null許容参照型の厳格化
# ------------------------------------------------------------------------------
dotnet_diagnostic.CS8600.severity = warning # null リテラルまたは null の可能性がある値を null 非許容型に変換しています
dotnet_diagnostic.CS8601.severity = warning # null 参照の代入の可能性があります
dotnet_diagnostic.CS8602.severity = warning # null 参照の逆参照です
dotnet_diagnostic.CS8603.severity = warning # null 参照の戻り値の可能性があります
dotnet_diagnostic.CS8604.severity = warning # null 参照の引数の可能性があります
dotnet_diagnostic.CS8618.severity = warning # null 非許容のフィールド/プロパティが未初期化です
dotnet_diagnostic.CS8625.severity = warning # null リテラルを null 非許容参照型に変換できません

# ------------------------------------------------------------------------------
# Microsoft.Unity.Analyzers
# ------------------------------------------------------------------------------
dotnet_diagnostic.UNT0001.severity = warning # 空のUnityイベント関数（Start/Update等）の放置を禁止
dotnet_diagnostic.UNT0002.severity = warning # tag == "..." ではなく CompareTag() を強制
dotnet_diagnostic.UNT0006.severity = error   # Unityイベント関数のシグネチャ間違い
dotnet_diagnostic.UNT0008.severity = error   # UnityEngine.Object に対する null合体演算子(??)の禁止（擬似null不整合防止）
dotnet_diagnostic.UNT0014.severity = error   # Component ではない型に対する GetComponent<T>() の呼び出し
dotnet_diagnostic.UNT0022.severity = warning # position / rotation の個別設定ではなく SetPositionAndRotation() を推奨
dotnet_diagnostic.UNT0023.severity = error   # UnityEngine.Object に対する null合体代入(??=)の禁止
dotnet_diagnostic.UNT0024.severity = warning # ベクトル計算よりスカラー計算を優先（最適化）
dotnet_diagnostic.UNT0029.severity = warning # パフォーマンス低下を招くパターンマッチングの検知

# Unity固有の警告抑制
dotnet_diagnostic.USP0003.severity = none    # ツールチップ/ヘッダー設定の整合性
dotnet_diagnostic.USP0004.severity = none    # SerializeField フィールドが初期化されていない警告の抑制
dotnet_diagnostic.USP0006.severity = none    # IDE0051: 未使用プライベートメンバー（Unityメッセージ）警告の抑制

# ------------------------------------------------------------------------------
# UniTask Analyzer
# ------------------------------------------------------------------------------
dotnet_diagnostic.UniTask0001.severity = error   # await されていない UniTask の検知
dotnet_diagnostic.UniTask0002.severity = warning # Forget() を明示せずに非同期メソッドを放置するミスを検知
dotnet_diagnostic.UniTask0003.severity = error   # 返り値が void の async メソッドの検知（UniTaskVoid を推奨）

# ------------------------------------------------------------------------------
# Microsoft.CodeAnalysis.BannedApiAnalyzers
# ------------------------------------------------------------------------------
dotnet_diagnostic.RS0030.severity = error # BannedSymbols.txt で指定された禁止APIの使用
dotnet_diagnostic.RS0031.severity = error # BannedSymbols.txt で指定された禁止型の使用